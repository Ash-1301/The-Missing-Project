  m_Name: 
  m_EditorClassIdentifier: 
  suspectName: Professor Hale
  greetingText: Oh hello Detective, have you been alright?
  portrait: {fileID: 0}
  questions:
  - questionText: What is this rusty key for?
    answerText: That opens the old storage room. Nothing important.
    requiresClueID: 3
    flagToSet: haleExplainedKey
    hasBeenAsked: 0
  - questionText: Why were you arranging meetings in Storage Room B?
    answerText: Storage Room B? I occasionally check archived equipment there. Nothing
      unusual.
    requiresClueID: 5
    flagToSet: haleActedDefensive
    hasBeenAsked: 0
  - questionText: Did you go to Dr. Reid's office yesterday?
    answerText: Yes, I wanted to use his computer for a bit as mine wasn't working
    requiresClueID: 0
    flagToSet: haleConfessed
    hasBeenAsked: 0
  - questionText: Your fingerprints are on the disk.
    answerText: That is absolutely absurd. I demand you speak to the university lawyers
      before continuing this conversation.
    requiresClueID: 4
    flagToSet: haleDeflected
    hasBeenAsked: 0
