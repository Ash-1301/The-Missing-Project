  m_Name: 
  m_EditorClassIdentifier: 
  suspectName: Maya
  greetingText: I've been expecting someone to come ask questions.
  portrait: {fileID: 0}
  questions:
  - questionText: Have you seen anything suspicious?
    answerText: I saw Prof. Hale in the lab very late.
    requiresClueID: 0
    flagToSet: mayaSeenHale
    hasBeenAsked: 0
  - questionText: Do you know who printed these emails?
    answerText: I don't know. The only with access is Dr Reid, sometimes he lets
      me in to use the desktop though but I haven't been come for a few days.
    requiresClueID: 2
    flagToSet: mayaRecognizedEmails
    hasBeenAsked: 0
  - questionText: Where is the storage room?
    answerText: It's in the lab, but it's always locked and I have only ever seen
      Professor Hale go inside.
    requiresClueID: 3
    flagToSet: mayaAskedAboutNote
    hasBeenAsked: 0
  - questionText: The disk was hidden behind the server rack.The disk was hidden
      behind the server rack.
    answerText: Behind the server rack? Only someone with access to that room would
      know that hiding spot. I've never even been in there...
    requiresClueID: 4
    flagToSet: mayaAdmittedPresence
    hasBeenAsked: 0
